<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Mobile targets need the Android/iOS workloads. Pass -p:CrossXMobileTargets=true to include them. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
        <TargetFrameworks Condition="'$(CrossXMobileTargets)' == 'true'">net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0"/>
        <PackageReference Include="ppy.SDL3_image-CS" Version="2026.722.0"/>
        <PackageReference Include="ppy.SDL3_mixer-CS" Version="2026.722.0"/>
        <PackageReference Include="SkiaSharp" Version="3.119.1"/>
        <PackageReference Include="NVorbis" Version="0.10.5" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Framework\" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Effects\Blur.frag.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Effects\Crt.frag.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Effects\Crt.vert.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Effects\FullscreenQuad.vert.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Effects\GlowComposite.frag.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Effects\SharpScale.frag.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Pipelines\Color.frag.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Pipelines\Color.vert.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Pipelines\ColorLight.frag.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Pipelines\ColorLight.vert.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Pipelines\Texture.frag.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Pipelines\Texture.vert.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Pipelines\TextureLight.frag.metal" />
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\Metal\Pipelines\TextureLight.vert.metal" />
    </ItemGroup>

    <ItemGroup>
      <!-- Direct3D 12 (Windows) shaders, compiled at runtime to DXBC SM 5.1 by D3DShaderCompiler. -->
      <EmbeddedResource Include="Framework.Backends\Sdl3Gpu\Assets\Shaders\HLSL\**\*.hlsl" />
    </ItemGroup>

    <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">
      <Reference Include="Mono.Android">
        <HintPath>..\..\..\..\..\..\..\usr\local\share\dotnet\packs\Microsoft.Android.Ref.36\36.1.53\ref\net10.0\Mono.Android.dll</HintPath>
      </Reference>
    </ItemGroup>

</Project>
