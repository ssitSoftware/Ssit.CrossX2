<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
        <PackageReference Include="ppy.SDL3-CS" Version="2026.722.0"/>
        <PackageReference Include="ppy.SDL3_image-CS" Version="2026.722.0"/>
        <PackageReference Include="ppy.SDL3_mixer-CS" Version="2026.722.0"/>
        <PackageReference Include="SkiaSharp" Version="3.119.1"/>
        <PackageReference Include="NVorbis" Version="0.10.5" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Graphics\Pipelines\" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Blur.frag.metal">
        <LogicalName>Shaders.Blur.frag.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Color.frag.metal">
        <LogicalName>Shaders.Color.frag.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Color.vert.metal">
        <LogicalName>Shaders.Color.vert.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Crt.frag.metal">
        <LogicalName>Shaders.Crt.frag.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Crt.vert.metal">
        <LogicalName>Shaders.Crt.vert.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\FullscreenQuad.vert.metal">
        <LogicalName>Shaders.FullscreenQuad.vert.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\GlowComposite.frag.metal">
        <LogicalName>Shaders.GlowComposite.frag.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Light.frag.metal">
        <LogicalName>Shaders.Light.frag.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Screen.frag.metal">
        <LogicalName>Shaders.Screen.frag.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Screen.vertPct.metal">
        <LogicalName>Shaders.Screen.vert.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Texture.frag.metal">
        <LogicalName>Shaders.Texture.frag.metal</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="_Sdl3Impl\Graphics\Shaders\Texture.vert.metal">
        <LogicalName>Shaders.Texture.vert.metal</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

</Project>
